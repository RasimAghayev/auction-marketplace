APP_NAME="Auction Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=auction_marketplace
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MongoDB (testing)
MONGODB_URI_TESTING=mongodb://localhost:27017
MONGODB_DATABASE_TESTING=auction_marketplace_testing

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Queue & Cache
QUEUE_CONNECTION=sync
CACHE_DRIVER=array
CACHE_PREFIX=
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Mail
MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=

# Broadcasting (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGIN_PATTERNS=

# CORS
CORS_ALLOWED_ORIGINS=*

# Activity log
ACTIVITY_LOGGER_ENABLED=true

# Swagger (OpenAPI)
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_BASE_PATH=/api/documentation

# Telescope
TELESCOPE_ENABLED=false

# Stripe (payments)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=