# Environment variables for Auction Marketplace
# Copy to .env and customize - NEVER commit real secrets

# ============================================================
# GENERAL
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=base64:your-generated-app-key-here

# Registry for built images
REGISTRY=ghcr.io/your-org
TAG=latest

# Git commit for image tagging
GIT_COMMIT=unknown

# Push images after build (for CI)
PUSH=false

# ============================================================
# DATABASE - MongoDB
# ============================================================
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=auction_marketplace
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=change-me-in-secrets

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-secrets

# ============================================================
# REVERB (WebSocket)
# ============================================================
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret

# ============================================================
# QUEUE & CACHE
# ============================================================
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# ============================================================
# FRONTEND
# ============================================================
VITE_API_URL=http://localhost/api
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# ============================================================
# MONITORING (optional)
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-secrets

# ============================================================
# MAIL (configure for production)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@auction.local
MAIL_FROM_NAME="Auction Marketplace"

# ============================================================
# STORAGE (AWS S3 / MinIO)
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=auction-marketplace
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================
# PAYMENT (Stripe)
# ============================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# SENTRY (Error tracking)
# ============================================================
SENTRY_LARAVEL_DSN=
SENTRY_VUE_DSN=